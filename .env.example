# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these under Project > Settings > Environment Variables.

# Supabase project URL and publishable key (Project Settings > API Keys).
# Safe to expose in the browser: access is controlled by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public base URL, e.g. https://study.helderlabs.com. Leave empty on previews
# (the deployment URL is used). Used in metadata and auth email links.
NEXT_PUBLIC_SITE_URL=

# Cloudflare Turnstile site key. Leave empty to turn CAPTCHA off.
# The matching secret key goes in Supabase (Authentication > Attack Protection), not here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Random string. Vercel Cron sends it to /api/cron/keep-alive. Server-only.
CRON_SECRET=
